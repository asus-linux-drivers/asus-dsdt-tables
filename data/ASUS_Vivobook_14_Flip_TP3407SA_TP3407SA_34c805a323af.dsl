            CreateDWordField (SBFB, \_SB.PC00.I2C0.TPD0._Y4D._SPE, SPED)  // _SPE: Speed
            CreateDWordField (SBFI, \_SB.PC00.I2C0.TPD0._Y4E._INT, INT2)  // _INT: Interrupts
            Method (_INI, 0, Serialized)  // _INI: Initialize
            {
                If ((OSYS < 0x07DC))
                {
                    SRXO (GPDI, One)
                }

                INT2 = INUM (GPDI)
                If ((TPDM == Zero))
                {
                    SHPO (GPDI, One)
                }

                SGRA (GPDI, TPDM)
                GRXE (GPDI, Zero)
                If ((TPDM == One))
                {
                    SGII (GPDI, Zero)
                }

                If ((TPDT == 0x05))
                {
                    Switch (ToInteger (TCTP))
                    {
                        Case (One)
                        {
                            _HID = "ASCE1205"
                            HID2 = One
                            BADR = 0x15
                            SPED = 0x00061A80
                            Return (Zero)
                        }
                        Case (0x02)
                        {
                            _HID = "ASCP1205"
                            HID2 = One
