            Method (GRPC, 1, Serialized)
            {
                Local0 = 0x03FF
                If ((Arg0 == One))
                {
                    ADBG ("PCIE Storage PEP")
                }

                If ((Arg0 == 0x02))
                {
                    ADBG ("PCIE LAN PEP")
                }

                If ((Arg0 == 0x03))
