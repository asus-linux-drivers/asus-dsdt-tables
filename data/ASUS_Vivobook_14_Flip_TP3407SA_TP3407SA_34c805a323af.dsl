                            SHRF ()
                            ADBG ("End WWAN PR _RST")
                            Release (WWMT)
                            ADBG ("WWAN PLDR Mutex: Release Done")
                            DOSV ()
                        }
                    }
                }

                Method (_PRR, 0, NotSerialized)  // _PRR: Power Resource for Reset
                {
                    Return (Package (0x01)
                    {
                        MRST
                    })
                }
