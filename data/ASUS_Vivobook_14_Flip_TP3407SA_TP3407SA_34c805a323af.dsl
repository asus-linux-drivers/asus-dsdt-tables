            }

            If ((Arg0 == 0x64))
            {
                Local0 &= 0x3F
                ^^PC00.LPCB.EC0.WRAM (0x07E7, Local0)
            }

            Notify (^^PC00.BAT0, 0x80) // Status Change
            Return (One)
        }
