                        Case (0x04)
                        {
                            _HID = "ASCP1201"
                            HID2 = One
                            BADR = 0x15
                            SPED = 0x00061A80
                            Return (Zero)
                        }
                        Default
                        {
                            _HID = "ASCE1205"
                            HID2 = One
                            BADR = 0x15
                            SPED = 0x00061A80
                            Return (Zero)
                        }

                    }
                }
