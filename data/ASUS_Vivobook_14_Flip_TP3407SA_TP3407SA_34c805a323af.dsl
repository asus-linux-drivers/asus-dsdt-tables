                    ADBG ("PCIE WWAN PEP")
                    If ((WRTO == 0x03))
                    {
                        ADBG ("PEP Constraint = D3")
                        Return (ToInteger (Local0))
                    }
                    ElseIf ((WRTO == 0x02))
