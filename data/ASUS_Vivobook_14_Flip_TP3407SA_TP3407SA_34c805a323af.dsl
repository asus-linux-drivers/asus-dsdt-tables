                {
                    ADBG ("PCIE Others")
                }

                If ((Arg0 == 0x63))
                {
                    ADBG ("PCIE EP NOT present")
                    Return (0xFF00)
                }

                If (CondRefOf (\_SB.PEPD.RPCO))
                {
                    Local0 &= RPCO (Arg0)
                }

                Return (ToInteger (Local0))
            }

