    Scope (_SB.PC00.RP01.PXSX)
    {
        Name (PERN, "RP01")
        Method (ISLN, 0, Serialized)
        {
            If ((BCCX == 0x02))
            {
                If ((SCCX == Zero))
                {
                    If ((PIXX == Zero))
                    {
                        ADBG ("PCIe LAN")
                        Return (One)
                    }
                }
            }

            Return (Zero)
        }

        Method (GRPT, 0, Serialized)
        {
            ADBG (Concatenate ("Root Port : ", PERN))
            If (PRES ())
            {
                If ((PAHC () || PNVM ()))
                {
                    Return (One)
                }

                If (ISGX ())
                {
                    Return (0x04)
                }

                If (ISLN ())
                {
                    Return (0x02)
                }

                If (CondRefOf (^WIST))
                {
                    If (WIST ())
                    {
                        Return (0x03)
                    }
                }

                If (CondRefOf (WWST))
                {
                    If (WWST ())
                    {
                        Return (0x06)
                    }
                }

                Return (Zero)
            }

            Return (0x63)
        }
    }

