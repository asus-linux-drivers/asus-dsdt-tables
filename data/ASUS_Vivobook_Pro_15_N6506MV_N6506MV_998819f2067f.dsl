                    CreateQWordField (NBU0, \_SB.PC02.HDAS._Y37._MAX, NMA0)  // _MAX: Maximum Base Address
                    CreateQWordField (NBU0, \_SB.PC02.HDAS._Y37._LEN, NLE0)  // _LEN: Length
