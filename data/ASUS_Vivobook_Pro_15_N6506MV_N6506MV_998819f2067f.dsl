            Field (VSEC, AnyAcc, NoLock, Preserve)
            {
                Offset (0x0C), 
                    ,   1, 
                BTIE,   1, 
                    ,   1, 
                    ,   1, 
                    ,   1, 
                    ,   1, 
                    ,   1, 
                Offset (0x0D), 
                PDRC,   1
            }

            OperationRegion (PBRR, SystemMemory, GMIO (PBNU, ^_ADR, _ADR), 0x02B8)
            Field (PBRR, AnyAcc, NoLock, Preserve)
            {
                Offset (0x18C), 
                MSNL,   32, 
                Offset (0x198), 
                L1C1,   32, 
                L1C2,   32, 
                Offset (0x2B4), 
                PTMR,   32
            }

            Method (WIST, 0, Serialized)
            {
                If (CondRefOf (VDID))
                {
                    Switch (ToInteger (VDID))
                    {
                        Case (0x25268086)
                        {
                            Return (One)
                        }
                        Case (0x271B8086)
                        {
                            Return (One)
                        }
                        Case (0x27238086)
                        {
                            Return (One)
                        }
                        Case (0x27258086)
                        {
                            Return (One)
                        }
                        Case (0x272B8086)
                        {
                            Return (One)
                        }
                        Default
