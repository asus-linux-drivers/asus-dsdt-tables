    Scope (_SB.ATKD)
    {
        Method (CRFC, 0, NotSerialized)
        {
            Name (PSSI, Zero)
            Name (FREQ, Zero)
            Local0 = Package (0x0A)
                {
                    Zero, 
                    Zero, 
                    Zero, 
                    Zero, 
                    Zero, 
                    Zero, 
                    Zero, 
                    Zero, 
                    Zero, 
                    Zero
                }
            If ((OSCP & 0x0400))
            {
                PSSI = SizeOf (^^PR00.TPSS)
            }
            Else
            {
                PSSI = SizeOf (^^PR00.LPSS)
            }

            FREQ = DerefOf (DerefOf (^^PR00.TPSS [Zero]) [Zero])
            Local0 [0x04] = FREQ /* \_SB_.ATKD.CRFC.FREQ */
            PSSI--
            FREQ = DerefOf (DerefOf (^^PR00.TPSS [PSSI]) [Zero])
            Local0 [0x06] = FREQ /* \_SB_.ATKD.CRFC.FREQ */
            Return (Local0)
        }
    }

    Scope (_SB.ATKD)
    {
        Method (SRSC, 1, NotSerialized)
        {
            ^^PC00.LPCB.EC0.WRAM (0x038F, Arg0)
            Local0 = ^^PC00.LPCB.EC0.RRAM (0x07E7)
            If ((Arg0 == 0x80))
            {
                Local0 |= 0xC0
                ^^PC00.LPCB.EC0.WRAM (0x07E7, Local0)
                ^^PC00.LPCB.EC0.WRAM (0x07E5, 0x5F)
                ^^PC00.LPCB.EC0.WRAM (0x07E6, 0x64)
            }

            If ((Arg0 == 0x50))
            {
                Local0 |= 0x80
                Local0 &= 0xBF
                ^^PC00.LPCB.EC0.WRAM (0x07E7, Local0)
                ^^PC00.LPCB.EC0.WRAM (0x07E6, Arg0)
                ^^PC00.LPCB.EC0.WRAM (0x07E5, Arg0)
            }

            If ((Arg0 == 0x64))
            {
                Local0 &= 0x3F
                ^^PC00.LPCB.EC0.WRAM (0x07E7, Local0)
                ^^PC00.LPCB.EC0.WRAM (0x07E5, 0x5F)
                ^^PC00.LPCB.EC0.WRAM (0x07E6, 0x64)
            }

            Notify (^^PC00.BAT0, 0x80) // Status Change
            Return (One)
        }
    }

    Scope (_SB.ATKD)
    {
        Method (FANL, 1, Serialized)
        {
            D8XH (Zero, 0x69)
            Local0 = Arg0
            If ((MFFG != 0xFF))
            {
                Local0 = 0xFF
            }

            NRSI = Local0
            ODV0 = Local0
            Notify (IETM, 0x88) // Device-Specific
            Switch (ToInteger (Local0))
            {
                Case (One)
                {
                    ^^PC00.LPCB.EC0.WRAM (0x08F4, 0x02)
                    FWMD ()
                    ^^PC00.LPCB.EC0.WRAM (0x05C2, 0x3C)
                    ^^PC00.LPCB.EC0.WRAM (0x05C3, 0x37)
                    ^^PC00.LPCB.EC0.WRAM (0x05C5, 0x03)
                }
                Case (0x02)
                {
                    ^^PC00.LPCB.EC0.WRAM (0x08F4, 0x03)
                    FPMD ()
                    ^^PC00.LPCB.EC0.WRAM (0x05C2, 0x62)
                    ^^PC00.LPCB.EC0.WRAM (0x05C3, 0x5A)
                    ^^PC00.LPCB.EC0.WRAM (0x05C5, 0x05)
                }
                Case (0x03)
                {
                    ^^PC00.LPCB.EC0.WRAM (0x08F4, 0x04)
                    FFMD ()
                    ^^PC00.LPCB.EC0.WRAM (0x05C2, 0x62)
                    ^^PC00.LPCB.EC0.WRAM (0x05C3, 0x5A)
                    ^^PC00.LPCB.EC0.WRAM (0x05C5, 0x05)
                }
                Case (0xFF)
                {
                    ^^PC00.LPCB.EC0.WRAM (0x08F4, 0x04)
                    FFMD ()
                    ^^PC00.LPCB.EC0.WRAM (0x05C2, 0x62)
                    ^^PC00.LPCB.EC0.WRAM (0x05C3, 0x5A)
                    ^^PC00.LPCB.EC0.WRAM (0x05C5, 0x05)
                }
                Default
                {
                    ^^PC00.LPCB.EC0.WRAM (0x08F4, One)
                    FSMD ()
                    ^^PC00.LPCB.EC0.WRAM (0x05C2, 0x62)
                    ^^PC00.LPCB.EC0.WRAM (0x05C3, 0x5A)
                    ^^PC00.LPCB.EC0.WRAM (0x05C5, 0x05)
                }

            }

            ^^PC00.LPCB.EC0.WRAM (0x0BEA, One)
            Local1 = (^^PC00.LPCB.EC0.RRAM (0x0BE7) | One)
            ^^PC00.LPCB.EC0.WRAM (0x0BE7, Local1)
            Notify (NPCF, 0xC0) // Hardware-Specific
            Return (One)
        }

        Method (GQFS, 0, NotSerialized)
        {
            Local0 = Zero
            Local0 |= 0x08000000
            Local0 |= 0x00040000
            Local0 |= 0x00020000
            Local0 |= 0x00010000
            Local0 |= NRSI /* \_SB_.NRSI */
            Return (Local0)
        }
    }

    Scope (_SB.ATKD)
    {
        OperationRegion (CSIO, SystemIO, 0x72, 0x02)
        Field (CSIO, ByteAcc, NoLock, Preserve)
        {
            IO72,   8, 
            IO73,   8
        }

        Method (AGPU, 1, Serialized)
        {
            If ((Arg0 == Zero))
            {
                AVID = Zero
            }

            ^^PC00.RP12.AGON ()
            Notify (^^PC00.RP12.PXSX, Zero) // Bus Check
            WGPO (Arg0)
            Return (One)
        }

        Method (WGPO, 1, Serialized)
        {
            Local0 = Zero
            While ((^^PC00.RP12.DVID == 0xFFFF))
            {
                ^^PC00.RP12.LNKA = Zero
                Sleep (0x64)
                Local0++
                If ((Local0 == 0xC8))
                {
                    Return (Zero)
                }
            }

            Return (One)
        }

        Method (RGPU, 1, Serialized)
        {
            IACF = One
            If (ATKP)
            {
                IANE (0xBE)
            }

            WOSR = One
            Notify (^^PC00.RP12.PXSX, 0x03) // Eject Request
            If (!WGPD (Arg0))
            {
                IACF = Zero
                Return (Zero)
            }

            If (ATKP)
            {
                IANE (0xC2)
            }

            IACF = Zero
            Return (One)
        }

        Method (WGPD, 1, Serialized)
        {
            Local0 = Zero
            While ((WOSR == One))
            {
                Sleep (0x64)
                Local0++
                If ((Local0 == 0xC8))
                {
                    WOSR = Zero
                    If (ATKP)
                    {
                        IANE (0xBC)
                    }

                    Return (Zero)
                }
            }

            Return (One)
        }

        Method (MAKY, 0, NotSerialized)
        {
            Return (Zero)
        }

        Method (BSTS, 0, NotSerialized)
        {
            If (ACPF)
            {
                Local0 = Zero
            }
            Else
            {
                Local0 = Zero
            }

            Return (Local0)
        }

        Method (WDOG, 1, NotSerialized)
        {
            Return (Zero)
        }

        Method (WLED, 1, NotSerialized)
        {
            Return (Zero)
        }

        Method (BLED, 1, NotSerialized)
        {
            Return (Zero)
        }

        Method (WMXC, 1, NotSerialized)
        {
            Return (Zero)
        }

        Method (OWGD, 1, Serialized)
        {
        }

        Method (SPTP, 1, NotSerialized)
        {
            If ((Arg0 == Zero)) {}
            If ((Arg0 == One)) {}
            If ((Arg0 == 0x02))
            {
                If ((OSYS >= 0x07DC))
                {
                    ^^PC00.LPCB.EC0.WRAM (0x0470, 0x14)
                    ^^PC00.LPCB.EC0.WRAM (0x0471, 0xE0)
                    ^^PC00.LPCB.EC0.WRAM (0x0472, 0x1F)
                    ^^PC00.LPCB.EC0.WRAM (0x0473, 0x5F)
                    ^^PC00.LPCB.EC0.WRAM (0x0474, 0xF0)
                    ^^PC00.LPCB.EC0.WRAM (0x0475, 0x5F)
                    ^^PC00.LPCB.EC0.WRAM (0x0476, 0xE0)
                    ^^PC00.LPCB.EC0.WRAM (0x0477, 0xF0)
                    ^^PC00.LPCB.EC0.WRAM (0x0478, 0x1F)
                    ^^PC00.LPCB.EC0.WRAM (0x0479, 0xF0)
                    ^^PC00.LPCB.EC0.WRAM (0x047A, 0x14)
                    ^^PC00.LPCB.EC0.ECXT (0xC1, 0x0B, Zero, Zero, Zero, Zero)
                }
            }
        }

        Method (SLKB, 1, NotSerialized)
        {
            Local0 = (Arg0 & 0x80)
            Local1 = (Arg0 & 0x0F)
            If (Local0)
            {
                ^^PC00.LPCB.EC0.WRAM (0x9042, Local1)
            }
            Else
            {
                ^^PC00.LPCB.EC0.WRAM (0x9042, Zero)
            }

            Return (One)
        }

        Method (GLKB, 1, NotSerialized)
        {
            If ((Arg0 == One))
            {
                Return (One)
            }
            ElseIf ((Arg0 == 0x02))
            {
                Local0 = ^^PC00.LPCB.EC0.RRAM (0x9042)
                If ((Local0 != Zero))
                {
                    Local0 |= 0x80
                }

                Return (Local0)
            }
            ElseIf ((Arg0 == 0x03))
            {
                Local0 = 0x80
                Return (Local0)
            }

            Return (One)
        }

        Method (GPDI, 1, NotSerialized)
        {
            Name (DOCK, Package (0x01)
            {
                Buffer (0x0A)
                {
                    /* 0000 */  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,  // ........
                    /* 0008 */  0x00, 0x00                                       // ..
                }
            })
            CreateField (DerefOf (DOCK [Zero]), Zero, One, CCCS)
            CreateField (DerefOf (DOCK [Zero]), One, 0x02, ROLE)
            CreateField (DerefOf (DOCK [Zero]), 0x03, One, TTTS)
            CreateField (DerefOf (DOCK [Zero]), 0x04, One, DVAL)
            CreateField (DerefOf (DOCK [Zero]), 0x10, 0x20, PRDU)
            CreateField (DerefOf (DOCK [Zero]), 0x4B, 0x02, DPWR)
            If ((Arg0 == One))
            {
                ROLE = ^^PC00.LPCB.EC0.RRAM (0x90BC)
            }
            Else
            {
                ROLE = ^^PC00.LPCB.EC0.RRAM (0x90BD)
            }

            CCCS = One
            TTTS = One
            DVAL = One
            PRDU = 0x0A010101
            DPWR = ^^PC00.LPCB.EC0.RRAM (0x90B5)
            Return (DOCK) /* \_SB_.ATKD.GPDI.DOCK */
        }

        Method (GPDC, 0, NotSerialized)
        {
            Local0 = ^^PC00.LPCB.EC0.RRAM (0x90BA)
            Local0 &= 0x0F
            Local0 |= 0x00010000
            ^^PC00.LPCB.EC0.WRAM (0x0B80, Local0)
            ^^PC00.LPCB.EC0.WRAM (0x0B81, (Local0 >> 0x08))
            ^^PC00.LPCB.EC0.WRAM (0x0B82, (Local0 >> 0x10))
            Return (Local0)
        }
    }

    Scope (_SB.ATKD)
    {
        Method (WCHK, 2, Serialized)
        {
            WNVA = 0x9603
            WNVB = One
            WNVC = Arg1
            WNVD = Arg0
            Return (W15H ())
        }
    }

