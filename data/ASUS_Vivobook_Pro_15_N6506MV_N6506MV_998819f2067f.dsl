                            Local0 = 0x0124F800
                            Local1 = 0x00493E00
                            Local2 = 0x32
                            Local3 = 0x04
                        }
                        Else
                        {
                            ADBG ("XTAL UNSUPPORTED")
                            Local0 = Zero
                            Local1 = Zero
                            Local2 = Zero
                            Local3 = Zero
                        }

                        DerefOf (DerefOf (Arg0 [One]) [One]) [One]
                             = Local0
                        DerefOf (DerefOf (DerefOf (Arg0 [One]) [0x08]
                            ) [One]) [Zero] = Local1
                        DerefOf (DerefOf (Arg0 [One]) [0x0A]) [One]
