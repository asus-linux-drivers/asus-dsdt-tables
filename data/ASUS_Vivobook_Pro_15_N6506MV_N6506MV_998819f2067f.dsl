                {
                    ADBG ("VIC1: Virtual I2C Device Entry")
                    Name (_UID, "VIC1")  // _UID: Unique ID
                    Name (_DDN, "Intel UsbI2C Device")  // _DDN: DOS Device Name
                    Method (_HID, 0, NotSerialized)  // _HID: Hardware ID
                    {
