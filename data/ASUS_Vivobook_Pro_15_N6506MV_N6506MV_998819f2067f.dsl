                        Sleep (0xC8)
                        Notify (PXSX, One) // Device Check
                        SGOV (PRST, (~WPRP & One))
                        SGOV (WBRS, (~PBRS & One))
                        Sleep (0xC8)
                        Local0 = Zero
                        While ((LASX == Zero))
                        {
                            If ((Local0 > 0x14))
                            {
                                ADBG ("FLDR TO")
