            If (ATKP)
            {
                Local0 = RRAM (0x038E)
                Local0 |= One
                WRAM (0x038E, Local0)
                ^^^^ATKD.IANE (0xE5)
            }
        }

        Method (_QAE, 0, NotSerialized)  // _Qxx: EC Query, xx=0x00-0xFF
        {
            D8XH (One, 0xAE)
            If (ATKP)
            {
                WRAM (0x038F, 0x50)
                WRAM (0x07E5, 0x50)
                WRAM (0x07E6, 0x50)
                ^^^^ATKD.IANE (0xE5)
            }
        }
    }

