                        0x00000000,         // Address Base
                        0x00690000,         // Address Length
                        _Y22)
                })
                CreateDWordField (SBR0, \_SB.PRRE._CRS._Y22._BAS, BAS0)  // _BAS: Base Address
                BAS0 = SBRG /* \SBRG */
                ConcatenateResTemplate (BUF0, SBR0, Local0)
                If (((PCHS == PCHH) || (PCHS == 0x04)))
                {
