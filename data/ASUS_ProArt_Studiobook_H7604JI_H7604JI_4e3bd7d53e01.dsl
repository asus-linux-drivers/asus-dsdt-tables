    Device (_SB.TPM)
    {
        Name (TMRQ, 0x0000006D)
        Name (TLVL, 0x00000000)
        Method (_HID, 0, NotSerialized)  // _HID: Hardware ID
        {
            If (TCMF)
            {
                Return (0x01013469)
            }
            ElseIf ((TTDP == Zero))
